rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só a equipe da Vinil Vale acessa dados compartilhados de clientes.
    // Qualquer conta Google consegue LOGAR no app, mas não passa daqui.
    // Para dar acesso a alguém novo, adicione o e-mail à lista e rode:
    //   firebase deploy --only firestore:rules
    function isEquipe() {
      return request.auth != null
        && request.auth.token.email in [
          'vinilvale@hotmail.com',
          'vinilvale.ads@gmail.com',
          'marcoslimablockchain@gmail.com'
        ];
    }

    // Central de Conteúdo: quem publica post NÃO precisa ver dado de cliente.
    // Lista separada de propósito — a isEquipe() acima continua sendo a única
    // porta para orçamento, contato, lead e conversa de WhatsApp.
    function isConteudo() {
      return request.auth != null
        && request.auth.token.email in [
          'vinilvale@hotmail.com',
          'vinilvale.ads@gmail.com',
          'marcoslimablockchain@gmail.com',
          'thamires.andrade171@gmail.com'
        ];
    }

    // Apenas o próprio usuário autenticado acessa seus dados
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Escrita (create/update): autenticado + dono + validações básicas
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().size() < 100;

      // Delete: autenticado + dono (sem validação de resource.data que não existe em deletes)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Validação extra para orçamentos: campos obrigatórios e tipos
    match /users/{userId}/orcamentos/{orcId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['id'])
        && (!request.resource.data.keys().hasAny(['tot']) ||
            request.resource.data.tot is number ||
            request.resource.data.tot is string);

      // Delete permitido para o próprio dono
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Contatos Google - somente equipe
    match /google_contacts/{contactId} {
      allow read, write: if isEquipe();
    }

    // Conversas WhatsApp - somente equipe (o bot escreve via Admin SDK, não passa por rules)
    match /whatsapp_conversations/{phone} {
      allow read: if isEquipe();
    }

    // Leads WhatsApp - somente equipe
    match /whatsapp_leads/{phone} {
      allow read: if isEquipe();
    }

    // ---------- Central de Conteúdo (prefixo cc_) ----------
    // Escopo de postagem: pauta, conteúdo, agendamento e alerta de fila.
    // Nenhuma dessas coleções guarda dado de cliente.

    match /cc_linhas/{id}        { allow read, write: if isConteudo(); }
    match /cc_config/{id}        { allow read, write: if isConteudo(); }
    match /cc_pautas/{id}        { allow read, write: if isConteudo(); }
    match /cc_conteudos/{id}     { allow read, write: if isConteudo(); }
    match /cc_agendamentos/{id}  { allow read, write: if isConteudo(); }
    // Alertas do Guardião de Fila (escritos pelo cron via service account)
    match /cc_alertas/{id}       { allow read, write: if isConteudo(); }

    // Bloqueia tudo mais por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
