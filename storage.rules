rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pasta de cada conta: FECHADA desde 26/11/2026. O sistema não grava nada
    // aqui (0 arquivos em users/ nesse dia) e o cadastro é aberto, então
    // qualquer conta nova podia guardar arquivo de qualquer tamanho e tipo na
    // própria pasta, por conta da empresa. Se um dia precisar, reabrir com
    // dono + teto de tamanho + tipo de arquivo, nunca só com o dono.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if false;
    }
    // ---------- Central de Conteúdo ----------
    // Vídeos dos posts. A LEITURA É PÚBLICA de propósito: para publicar no
    // Instagram, a Meta baixa o arquivo pela URL — se exigir autenticação,
    // a publicação falha. Só quem publica consegue enviar, e essa lista é
    // separada da equipe que enxerga dado de cliente. (Apagar não passa para
    // ninguém: no delete não existe request.resource e a conta do tamanho
    // abaixo dá erro — visto no simulador em 25/11/2026.)
    match /central-conteudo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        // E-mail precisa estar confirmado (ver emailConfirmado() no
        // firestore.rules). Sem isso, quem criasse conta com um e-mail da
        // lista que ainda não tem conta subia arquivo de leitura pública
        // (até 300 MB cada) no bucket da empresa.
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email in [
          'vinilvale.ads@gmail.com',
          'marcoslimablockchain@gmail.com',
          'thamires.andrade171@gmail.com'
        ]
        // Teto de 300 MB e só vídeo ou imagem.
        && request.resource.size < 300 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('image/.*'));
    }

    // Bloqueia todo acesso não autorizado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
